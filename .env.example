# Режим: debug або production
ENV=debug

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medical_centre

# Binotel
BINOTEL_API_KEY=your_binotel_api_key
BINOTEL_API_SECRET=your_binotel_api_secret
BINOTEL_API_URL=https://api.binotel.com

# API клініки
CLINIC_API_URL=https://your-clinic-api.com/api/v1
CLINIC_API_KEY=your_clinic_api_key

# Планувальник
SCHEDULER_FETCH_HOUR=8
SCHEDULER_CALL_HOUR=10
DAYS_BEFORE_VISIT=1
MAX_CALL_ATTEMPTS=3

CREATE DATABASE medical_centre;