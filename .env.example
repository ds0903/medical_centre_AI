# Режим: debug або production
ENV=debug

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medical_centre

# Binotel REST API
# Отримати в особистому кабінеті: https://my.binotel.ua
BINOTEL_API_KEY=your_binotel_api_key
BINOTEL_API_SECRET=your_binotel_api_secret

# Binotel SIP (для production аудіо-мосту)
# Отримати у підтримки Binotel: support@binotel.ua
BINOTEL_INTERNAL_NUMBER=900         # внутрішній номер бота (SIP extension)
BINOTEL_SIP_SERVER=sip1.binotel.com # SIP сервер (sip1..sip22.binotel.com)
BINOTEL_SIP_PORT=5060               # стандартний SIP порт
BINOTEL_SIP_USERNAME=900            # зазвичай = BINOTEL_INTERNAL_NUMBER
BINOTEL_SIP_PASSWORD=your_sip_password
BINOTEL_OPERATOR_NUMBER=901         # внутрішній номер живого оператора

# API клініки
CLINIC_API_URL=https://your-clinic-api.com/api/v1
CLINIC_API_KEY=your_clinic_api_key

# Планувальник
SCHEDULER_FETCH_HOUR=8
SCHEDULER_CALL_HOUR=10
DAYS_BEFORE_VISIT=1
MAX_CALL_ATTEMPTS=3
PAUSE_BETWEEN_CALLS_SEC=30
